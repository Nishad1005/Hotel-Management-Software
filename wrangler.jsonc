{
  // Cloudflare deploy config.
  //
  // Cloudflare folded Pages into Workers, so connecting a Git repository now creates a
  // Worker and runs `wrangler deploy` rather than uploading a Pages directory. With no
  // config file, wrangler tries to detect the application itself, finds a pnpm
  // workspace with five packages, and refuses:
  //
  //   The Cloudflare application detection logic has been run in the root of a
  //   workspace instead of targeting a specific project.
  //
  // That is the whole cause of the failed deploy. The build itself succeeded.
  //
  // This file lives at the repo root because that is where the build and the deploy
  // command both run, and `assets.directory` is resolved relative to it.

  // Must match the Worker name in the Cloudflare dashboard, or wrangler deploys a
  // differently-named Worker and the project points at nothing.
  "name": "hotel-management-software",

  "compatibility_date": "2026-08-13",

  // No `main`. There is no Worker script and there should not be one: this is a static
  // single-page app (ADR 0014, ADR 0016), and giving it a server would quietly create a
  // second place where behaviour can live.
  "assets": {
    "directory": "./apps/mobile/dist",

    // The SPA fallback. `web.output` is "single", so there is one HTML file and routing
    // happens on the client — a refresh on /items or /perishables asks for a file that
    // does not exist. This serves index.html for any unmatched path, with a 200, while
    // real files under /_expo/ and /assets/ are still matched first.
    //
    // apps/mobile/public/_redirects expresses the same rule in the portable form that
    // Netlify and others read. It is kept deliberately: this setting is Cloudflare's
    // mechanism, that file is the one that travels if the host ever changes.
    "not_found_handling": "single-page-application"
  }
}
