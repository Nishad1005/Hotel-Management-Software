# pnpm 11 verifies the dependency tree before every `pnpm exec` / `pnpm run`. On this
# project that check reaches the network to re-resolve the Supabase CLI's optional
# per-platform binaries (linux-x64, darwin-arm64, ...), none of which a Windows
# machine needs, and a slow or blocked fetch then stalls the command before it starts.
#
# Turning it off means an out-of-date node_modules will not self-heal. Run
# `pnpm install` after changing dependencies, as you would have anyway. CI installs
# with --frozen-lockfile on every run, so it is unaffected.
verify-deps-before-run=false
