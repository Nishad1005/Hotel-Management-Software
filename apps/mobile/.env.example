# Copy this file to .env.local and fill in the two values.
# .env* is gitignored; .env.example is the committed template.
#
# Supabase Dashboard -> Project Settings -> API
#
# Neither of these is a secret. EXPO_PUBLIC_* variables are inlined into the app
# bundle at build time, so anything here is readable by anyone who has the app. That
# is fine for these two: the URL identifies the project, and the anon key only ever
# reaches rows that row level security already permits.
#
# The service_role key is an entirely different thing. It bypasses RLS completely and
# must never appear in this file, in the app, or in the repository — CLAUDE.md rule 3,
# and the way cross-tenant leaks actually happen in Supabase projects.

EXPO_PUBLIC_SUPABASE_URL=https://dwnuxeeglkpsssissmuu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-public-key-here
