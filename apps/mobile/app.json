{
  "expo": {
    "name": "PARGOLAI",
    "slug": "golai",
    "version": "0.0.0",
    "scheme": "golai",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-sqlite"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.golai.app"
    },
    "android": {
      "package": "in.golai.app",
      "adaptiveIcon": {
        "backgroundColor": "#33241D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "PARGOLAI",
      "shortName": "PARGOLAI",
      "description": "Material flow control for hotels — gate to dock to zone to department, with the FSSAI registers as a by-product.",
      "display": "standalone",
      "lang": "en-IN",
      "themeColor": "#33241D",
      "backgroundColor": "#FAF7F4"
    }
  }
}
